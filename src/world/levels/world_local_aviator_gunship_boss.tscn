[node name="Areas" type="Node" parent="Level"]

[node name="AllPlayersAreaTrigger" type="Area3D" parent="Level/Areas"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.4995, 0, -22.4925)
script = ExtResource("all_players")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Level/Areas/AllPlayersAreaTrigger"]
shape = SubResource("BoxShape3D_arena")

[node name="Weapon" type="Node3D" parent="."]

[node name="ForkCannon" parent="Weapon" instance=ExtResource("fork_cannon")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.4995, 0.593, -13.4955)

[node name="AudioStreamPlayer" type="AudioStreamPlayer" parent="."]
stream = ExtResource("music")
volume_db = -20.14
autoplay = true
bus = &"Music"
parameters/looping = true

[node name="ShowMessageAtLaunch" type="Node" parent="."]
script = ExtResource("launch_message")
message_string = "[color=#88ddff]The Aviator's Gunship[/color]

When the red line appears, get out of its path:
the laser sweeps straight across the deck.
Red rings show where rockets will land."

[node name="ShowBossHealthBar" type="Node" parent="." node_paths=PackedStringArray("fight_trigger", "enemy_group")]
script = ExtResource("show_boss_bar")
fight_trigger = NodePath("../Level/Areas/AllPlayersAreaTrigger")
enemy_group = NodePath("../Enemies/BossGroup")
boss_icon = ExtResource("boss_icon")
boss_name = "The Aviator"

[connection signal="all_players_inside" from="Level/Areas/AllPlayersAreaTrigger" to="Level/Events/WakeBoss" method="trigger"]
[connection signal="enemies_defeated" from="Enemies/BossGroup" to="Level/Events/LevelSucceeded" method="trigger"]

[node name="AudioStreamPlayer" type="AudioStreamPlayer" parent="."]
stream = ExtResource("music")
volume_db = -20.14
autoplay = true
bus = &"Music"
parameters/looping = true

[node name="ShowMessageAtLaunch" type="Node" parent="."]
script = ExtResource("launch_message")
message_string = "[color=#88ddff]Sky Station[/color]

Board the barge together.
Winged mechs guard the crossing."

[connection signal="all_players_inside" from="Level/EndLevelArea" to="Level/Events/LevelSucceeded" method="trigger"]
